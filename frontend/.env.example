# URL base de la API (backend). En producción apuntar a tu API desplegada.
VITE_API_URL=https://tu-backend.ejemplo.com/api

# URL pública del sitio (para canonical, Open Graph y sitemap). Ej: https://cscdforever.com
VITE_APP_URL=https://cscdforever.com

# Cloudflare Turnstile: clave pública del sitio (CAPTCHA en login y alquiler de cancha).
# Sin valor = en desarrollo se envía "dev-bypass" (el backend con TURNSTILE_SECRET_KEY vacío acepta).
# Obtener en https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=
