# =============================================================================
# CONFIGURACIÓN DEL SERVIDOR
# =============================================================================
NODE_ENV=development
PORT=3000

# =============================================================================
# BASE DE DATOS (PostgreSQL)
# =============================================================================
# En producción usar la URL de tu instancia (Supabase, Cloud SQL, etc.).
# Opcional: ?connection_limit=10&connect_timeout=15
DATABASE_URL="postgresql://usuario:password@localhost:5432/forever"

# =============================================================================
# AUTENTICACIÓN JWT
# =============================================================================
# OBLIGATORIO en producción: mínimo 32 caracteres aleatorios.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=default-secret-change-me

# Expiración del token: 7d, 24h, 60m, etc.
JWT_EXPIRES_IN=7d

# =============================================================================
# COOKIES (para sesión HttpOnly)
# =============================================================================
# sameSite: "lax" (default) | "none" (solo si front y API en dominios distintos)
COOKIE_SAME_SITE=lax

# secure: true en producción; obligatorio si COOKIE_SAME_SITE=none
# Valores: true | false (en dev puede ser false)
COOKIE_SECURE=false

# Nombre de la cookie (opcional)
# AUTH_COOKIE_NAME=forever_token

# =============================================================================
# CORS - FRONTEND
# =============================================================================
# Orígenes permitidos, separados por coma si hay varios
FRONTEND_URL=http://localhost:5173

# =============================================================================
# MERCADO PAGO
# =============================================================================
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_SUCCESS_URL=http://localhost:5173/pagos/success
MERCADOPAGO_FAILURE_URL=http://localhost:5173/pagos/failure
MERCADOPAGO_PENDING_URL=http://localhost:5173/pagos/pending
MERCADOPAGO_WEBHOOK_URL=
# Opcional: validar firma del webhook (Tus integraciones > Webhooks)
# MERCADOPAGO_WEBHOOK_SECRET=
# Opcional: email de la cuenta vendedor MP. Si el pagador usa el mismo (ej. Sandbox), se fuerza email fantasma para evitar auto-compra.
# MERCADOPAGO_SELLER_EMAIL=

# =============================================================================
# LOGIN (bloqueo por intentos fallidos)
# =============================================================================
MAX_LOGIN_ATTEMPTS=5
LOGIN_BLOCK_TIME=15

# =============================================================================
# CLUB
# =============================================================================
CLUB_NAME=Club Deportivo Forever
PRINCIPAL_ADMIN_EMAIL=admin@foreverclub.com
# WhatsApp: código país + número sin +. Ej: 5492211234567
CLUB_WHATSAPP_NUMBER=5492211234567
