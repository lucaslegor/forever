NODE_ENV=production
PORT=3000

# Frontend (Vercel)
FRONTEND_URL=https://cscdforever.com

# Cookies (JWT HttpOnly)
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
AUTH_COOKIE_NAME=forever_token

# Seguridad
JWT_SECRET=CHANGE_ME_32+_CHARS_RANDOM
JWT_EXPIRES_IN=7d

# DB (Cloud SQL por IP privada)
DATABASE_URL=postgresql://USER:PASSWORD@10.x.x.x:5432/DBNAME?schema=public

# Turnstile (Cloudflare) - requerido si querés validar captcha
TURNSTILE_SECRET_KEY=

# Mercado Pago (si se usa en producción)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_SUCCESS_URL=https://cscdforever.com/pagos/success
MERCADOPAGO_FAILURE_URL=https://cscdforever.com/pagos/failure
MERCADOPAGO_PENDING_URL=https://cscdforever.com/pagos/pending
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SELLER_EMAIL=

# Admin principal (opcional, default admin@foreverclub.com)
PRINCIPAL_ADMIN_EMAIL=admin@foreverclub.com

